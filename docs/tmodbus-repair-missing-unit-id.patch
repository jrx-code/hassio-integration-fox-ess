diff --git a/tests/transport/test_async_tcp.py b/tests/transport/test_async_tcp.py
index bc6883e..d7fff01 100644
--- a/tests/transport/test_async_tcp.py
+++ b/tests/transport/test_async_tcp.py
@@ -7,7 +7,7 @@ from unittest.mock import AsyncMock, MagicMock, patch
 
 import pytest
 from tmodbus.exceptions import InvalidRequestError, InvalidResponseError, ModbusConnectionError, ModbusResponseError
-from tmodbus.pdu.base import BaseClientPDU
+from tmodbus.pdu.base import RT, BaseClientPDU
 from tmodbus.pdu.serial_line import DiagnosticsForceListenOnlyModePDU
 from tmodbus.transport.async_tcp import AsyncTcpTransport, ModbusTcpProtocol, _ModbusMessage
 
@@ -817,3 +817,68 @@ async def test_transport_send_and_receive_delegates_to_protocol(monkeypatch: pyt
 
     # Cleanup
     await t.close()
+
+
+async def _exchange(protocol: ModbusTcpProtocol, unit_id: int, pdu: BaseClientPDU[RT], response: bytes) -> RT:
+    """Send ``pdu`` on ``protocol`` and feed ``response`` to it."""
+    mock_transport = MagicMock(spec=asyncio.WriteTransport)
+    mock_transport.is_closing.return_value = False
+    protocol.connection_made(mock_transport)
+    task = asyncio.create_task(protocol.send_and_receive(unit_id, pdu))
+    await asyncio.sleep(0.01)
+    protocol.data_received(response)
+    return await task
+
+
+class _ReadHoldingPDU(BaseClientPDU[bytes]):
+    """Read holding registers 30016 x3, as sent to a FoxESS H3."""
+
+    function_code = 0x03
+
+    def encode_request(self) -> bytes:
+        return b"\x03\x75\x40\x00\x03"
+
+    def decode_response(self, data: bytes) -> bytes:
+        return data
+
+
+# Captured from a FoxESS H3 (Master 2.23 / Manager 1.95) behind a USR RS485 gateway:
+# the RTU slave address 0xF7 is missing, so the gateway sends the function code as unit id.
+_SHORT_FRAME = bytes.fromhex("0001 0000 0008 03 06 00df 0067 0195".replace(" ", ""))
+_GOOD_FRAME = bytes.fromhex("0001 0000 0009 f7 03 06 00df 0067 0195".replace(" ", ""))
+_SHORT_EXCEPTION = bytes.fromhex("0001 0000 0002 83 02".replace(" ", ""))
+
+
+async def test_repair_missing_unit_id_off_by_default() -> None:
+    protocol = ModbusTcpProtocol(on_connection_lost=lambda _: None)
+    with pytest.raises(InvalidResponseError, match="Unit ID mismatch"):
+        await _exchange(protocol, 0xF7, _ReadHoldingPDU(), _SHORT_FRAME)
+
+
+async def test_repair_missing_unit_id() -> None:
+    protocol = ModbusTcpProtocol(on_connection_lost=lambda _: None, repair_missing_unit_id=True)
+    assert await _exchange(protocol, 0xF7, _ReadHoldingPDU(), _SHORT_FRAME) == bytes.fromhex("030600df00670195")
+
+
+async def test_repair_missing_unit_id_leaves_good_frames() -> None:
+    protocol = ModbusTcpProtocol(on_connection_lost=lambda _: None, repair_missing_unit_id=True)
+    assert await _exchange(protocol, 0xF7, _ReadHoldingPDU(), _GOOD_FRAME) == bytes.fromhex("030600df00670195")
+
+
+async def test_repair_missing_unit_id_exception_response() -> None:
+    protocol = ModbusTcpProtocol(on_connection_lost=lambda _: None, repair_missing_unit_id=True)
+    with pytest.raises(ModbusResponseError):
+        await _exchange(protocol, 0xF7, _ReadHoldingPDU(), _SHORT_EXCEPTION)
+
+
+async def test_repair_missing_unit_id_ignores_other_units() -> None:
+    """A unit id that is not the function code is a real mismatch."""
+    protocol = ModbusTcpProtocol(on_connection_lost=lambda _: None, repair_missing_unit_id=True)
+    other_unit = bytes.fromhex("0001 0000 0009 02 03 06 00df 0067 0195".replace(" ", ""))
+    with pytest.raises(InvalidResponseError, match="Unit ID mismatch"):
+        await _exchange(protocol, 0xF7, _ReadHoldingPDU(), other_unit)
+
+
+async def test_transport_passes_repair_to_protocol() -> None:
+    assert AsyncTcpTransport("host").repair_missing_unit_id is False
+    assert AsyncTcpTransport("host", repair_missing_unit_id=True).repair_missing_unit_id is True
